NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Used by scripts/seed-user.mjs; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Server-only. SMTP the app uses to email sign-up / reset codes
# (src/lib/email/sendCodeEmail.js). Leave unset in local dev to print the
# code in the `npm run dev` terminal instead. Gmail: smtp.gmail.com, 587,
# your Gmail address, and a 16-character App password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ascendus Careers <you@gmail.com>"

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) on the apply review step.
# Create a v2 checkbox key at https://www.google.com/recaptcha/admin and add
# your domains (and localhost). Unset in development, Google's test keys are
# used and always pass; production refuses to submit until both are set.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server-only; never prefix with NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=

# Server-only. The Ascendus website's Supabase project, which holds the
# `jobs` table (src/lib/jobs.js). Its publishable key is enough.
JOBS_SUPABASE_URL=https://website-project-ref.supabase.co
JOBS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
